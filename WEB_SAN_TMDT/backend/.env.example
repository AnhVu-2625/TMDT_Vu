# ================================================
# DATABASE CONFIGURATION
# ================================================

# SQL Server Connection
# Windows Auth Example: DB_SERVER=LAPTOP-ANHVU
# SQL Auth Example: DB_SERVER=localhost (+ DB_USER & DB_PASSWORD)
DB_SERVER=localhost
DB_DATABASE=ThuongMaiDienTu
DB_PORT=1433

# For SQL Server Authentication (not Windows)
# DB_USER=sa
# DB_PASSWORD=YourPassword123

# SSL/Security
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ================================================
# SERVER CONFIGURATION
# ================================================
PORT=5000
NODE_ENV=development

# ================================================
# JWT & SECURITY
# ================================================
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure_2024
JWT_EXPIRE=7d

# ================================================
# EMAIL CONFIGURATION (for OTP)
# ================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_or_token
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=noreply@marthub.com

# ================================================
# FILE UPLOAD
# ================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ================================================
# FRONTEND URL (CORS)
# ================================================
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ================================================
# NOTES
# ================================================
# 1. For Windows Authentication (recommended):
#    - Leave DB_USER and DB_PASSWORD empty
#    - Requires Windows login with SQL Server access
#    - Uses ODBC Driver 18 for SQL Server
#
# 2. For SQL Server Authentication:
#    - Set DB_USER=sa and DB_PASSWORD=your_password
#    - Uses mssql tedious driver
#
# 3. Email Configuration:
#    - For Gmail: Use App Password (not regular password)
#    - Generate: https://myaccount.google.com/apppasswords
#
# 4. JWT Secret:
#    - Generate random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

